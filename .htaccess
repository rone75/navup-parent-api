# API des parents NavUp — protections du web root
Options -Indexes

RewriteEngine on
# Dossiers internes jamais servis en HTTP (dépôt git, classes, config et secrets, SQL, scripts CLI)
RewriteRule ^(\.git|include|require|sql|script-cgi)(/|$) - [F,L]

# Fichiers cachés (.gitignore…) et fichiers sensibles
<FilesMatch "(^\.|\.(sql|md|log)$)">
    Require all denied
</FilesMatch>

# Compression des réponses JSON
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json text/plain
</IfModule>

# Depuis Apache 2.4.59, l'en-tête Content-Length d'une réponse de PHP est retiré par précaution (réponse découpée).
# Les médias en ont besoin : la taille d'un audio, celle d'une plage (lecture sur iPhone, barre d'avancement).
# Cette API n'écrit Content-Length qu'à un endroit (Media::envoyer), d'après la taille du fichier sur le disque.
SetEnv ap_trust_cgilike_cl 1
